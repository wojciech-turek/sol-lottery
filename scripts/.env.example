# Solana RPC endpoint used by the devnet smoke / comprehensive / many-buyers
# scripts. Falls back to Solana devnet when unset.
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Path to the keypair used to sign script transactions.
# Defaults to ~/.config/solana/id.json when unset.
ANCHOR_WALLET=""

# Postgres connection — read by @sol-lottery/db when scripts import `prisma`
# (e.g. db-stats.ts, devnet-smoke.ts). Must point at the same database the
# indexer/web app use.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sol_lottery?schema=public"
