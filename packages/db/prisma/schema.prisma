// Prisma schema for sol-lottery.
//
// Convention: Prisma models stay PascalCase and fields stay camelCase
// (idiomatic for TypeScript), but every table and column is mapped to
// snake_case at the database layer via `@@map` / `@map`. That gives us
// idiomatic Postgres on disk and idiomatic JS in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Lottery configurations and their state transitions
// ---------------------------------------------------------------------------

model Lottery {
  pubkey               String         @id
  lotteryIndex         BigInt         @unique                @map("lottery_index")
  name                 String
  state                LotteryState
  prizeKind            PrizeKind                              @map("prize_kind")
  ticketPriceLamports  BigInt                                 @map("ticket_price_lamports")
  durationSeconds      BigInt                                 @map("duration_seconds")
  autoRollover         Boolean        @default(false)         @map("auto_rollover")
  manualResolution     Boolean        @default(false)         @map("manual_resolution")
  admin                String
  createdAt            DateTime                               @map("created_at")
  updatedAt            DateTime       @updatedAt              @map("updated_at")

  rounds               LotteryRound[]
  stateChanges         LotteryStateLog[]

  @@index([state])
  @@map("lottery")
}

enum LotteryState {
  ACTIVE
  PAUSED
  PENDING_DISABLE
  DISABLED

  @@map("lottery_state")
}

enum PrizeKind {
  SOL
  PHYSICAL

  @@map("prize_kind")
}

model LotteryStateLog {
  id            String       @id @default(cuid())
  lotteryPubkey String                                @map("lottery_pubkey")
  lottery       Lottery      @relation(fields: [lotteryPubkey], references: [pubkey])
  previousState LotteryState                          @map("previous_state")
  newState      LotteryState                          @map("new_state")
  at            DateTime
  txSignature   String                                @map("tx_signature")

  @@index([lotteryPubkey, at])
  @@map("lottery_state_log")
}

// ---------------------------------------------------------------------------
// Rounds and their lifecycle
// ---------------------------------------------------------------------------

model LotteryRound {
  pubkey                    String              @id
  lotteryPubkey             String                                              @map("lottery_pubkey")
  lottery                   Lottery             @relation(fields: [lotteryPubkey], references: [pubkey])
  index                     BigInt
  state                     RoundState          @default(OPEN)
  ticketPriceLamports       BigInt                                              @map("ticket_price_lamports")
  durationSeconds           BigInt                                              @map("duration_seconds")
  startedAt                 DateTime                                            @map("started_at")
  effectiveEnd              DateTime                                            @map("effective_end")
  pausedTotalSeconds        BigInt              @default(0)                     @map("paused_total_seconds")
  ticketsSold               BigInt              @default(0)                     @map("tickets_sold")
  donatedLamports           BigInt              @default(0)                     @map("donated_lamports")
  winner                    String?
  winningTicketIndex        BigInt?                                             @map("winning_ticket_index")
  poolAmountLamports        BigInt?                                             @map("pool_amount_lamports")
  totalDistributedLamports  BigInt?                                             @map("total_distributed_lamports")
  resolvedAt                DateTime?                                           @map("resolved_at")
  currentShardIndex         Int                 @default(0)                     @map("current_shard_index")

  tickets                   TicketPurchase[]
  donations                 Donation[]

  @@unique([lotteryPubkey, index])
  @@index([state])
  @@map("lottery_round")
}

enum RoundState {
  OPEN
  CLOSED
  AWAITING_VRF
  RESOLVED

  @@map("round_state")
}

// ---------------------------------------------------------------------------
// Per-event transactional records
// ---------------------------------------------------------------------------

model TicketPurchase {
  txSignature        String       @id                          @map("tx_signature")
  roundPubkey        String                                    @map("round_pubkey")
  round              LotteryRound @relation(fields: [roundPubkey], references: [pubkey])
  buyer              String
  quantity           BigInt
  totalPaidLamports  BigInt                                    @map("total_paid_lamports")
  runningTotal       BigInt                                    @map("running_total")
  at                 DateTime

  @@index([roundPubkey, at])
  @@index([buyer])
  @@map("ticket_purchase")
}

model Donation {
  txSignature           String       @id                                @map("tx_signature")
  roundPubkey           String                                          @map("round_pubkey")
  round                 LotteryRound @relation(fields: [roundPubkey], references: [pubkey])
  donor                 String
  amountLamports        BigInt                                          @map("amount_lamports")
  runningTotalLamports  BigInt                                          @map("running_total_lamports")
  at                    DateTime

  @@index([roundPubkey, at])
  @@index([donor])
  @@map("donation")
}

model User {
  pubkey      String   @id
  isAdmin     Boolean  @default(false)              @map("is_admin")
  createdAt   DateTime @default(now())              @map("created_at")
  lastSeenAt  DateTime @default(now()) @updatedAt   @map("last_seen_at")

  @@map("user")
}

model AdminTransfer {
  txSignature   String   @id                @map("tx_signature")
  previousAdmin String                      @map("previous_admin")
  newAdmin      String                      @map("new_admin")
  at            DateTime

  @@map("admin_transfer")
}

/// Raw mirror of every program-emitted event; useful for replay/debug.
model RawEvent {
  txSignature  String   @id              @map("tx_signature")
  slot         BigInt
  blockTime    DateTime?                 @map("block_time")
  eventName    String                    @map("event_name")
  payload      Json

  @@index([eventName, slot])
  @@map("raw_event")
}
