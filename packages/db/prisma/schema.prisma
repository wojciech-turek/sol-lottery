// Prisma schema for sol-lottery.
//
// Models are aligned with the on-chain events emitted by the program
// (`programs/lottery/src/events.rs`). The indexer (`apps/indexer`) listens
// for those events and writes rows here; the frontend (`apps/web`) reads
// them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lottery configurations and their state transitions
// ---------------------------------------------------------------------------

model Lottery {
  /// The Lottery PDA (base58).
  pubkey               String         @id
  chainId              BigInt         @unique
  name                 String
  state                LotteryState
  prizeKind            PrizeKind
  ticketPriceLamports  BigInt
  durationSeconds      BigInt
  autoRollover         Boolean        @default(false)
  admin                String
  createdAt            DateTime
  updatedAt            DateTime       @updatedAt

  rounds               LotteryRound[]
  stateChanges         LotteryStateLog[]

  @@index([state])
}

enum LotteryState {
  ACTIVE
  PAUSED
  PENDING_DISABLE
  DISABLED
}

enum PrizeKind {
  SOL
  PHYSICAL
}

model LotteryStateLog {
  id            String       @id @default(cuid())
  lotteryPubkey String
  lottery       Lottery      @relation(fields: [lotteryPubkey], references: [pubkey])
  previousState LotteryState
  newState      LotteryState
  at            DateTime
  txSignature   String

  @@index([lotteryPubkey, at])
}

// ---------------------------------------------------------------------------
// Rounds and their lifecycle
// ---------------------------------------------------------------------------

model LotteryRound {
  /// The Round PDA (base58).
  pubkey                    String              @id
  lotteryPubkey             String
  lottery                   Lottery             @relation(fields: [lotteryPubkey], references: [pubkey])
  index                     BigInt
  state                     RoundState          @default(OPEN)
  ticketPriceLamports       BigInt
  durationSeconds           BigInt
  startedAt                 DateTime
  effectiveEnd              DateTime
  pausedTotalSeconds        BigInt              @default(0)
  ticketsSold               BigInt              @default(0)
  winner                    String?
  winningTicketIndex        BigInt?
  poolAmountLamports        BigInt?
  totalDistributedLamports  BigInt?
  resolvedAt                DateTime?

  tickets                   TicketPurchase[]

  @@unique([lotteryPubkey, index])
  @@index([state])
}

enum RoundState {
  OPEN
  CLOSED
  AWAITING_VRF
  RESOLVED
}

// ---------------------------------------------------------------------------
// Per-event transactional records (cheap to query, easy to replay)
// ---------------------------------------------------------------------------

model TicketPurchase {
  txSignature        String       @id
  roundPubkey        String
  round              LotteryRound @relation(fields: [roundPubkey], references: [pubkey])
  buyer              String
  quantity           BigInt
  totalPaidLamports  BigInt
  runningTotal       BigInt
  at                 DateTime

  @@index([roundPubkey, at])
  @@index([buyer])
}

model AdminTransfer {
  txSignature   String   @id
  previousAdmin String
  newAdmin      String
  at            DateTime
}

/// Raw mirror of every program-emitted event; useful for replay/debug.
model RawEvent {
  txSignature  String   @id
  slot         BigInt
  blockTime    DateTime?
  eventName    String
  payload      Json

  @@index([eventName, slot])
}
