# Solana RPC endpoint the indexer subscribes to for program logs.
SOLANA_RPC_URL="http://127.0.0.1:8899"

# Deployed lottery program ID the indexer watches.
LOTTERY_PROGRAM_ID=""

# Postgres connection (pooled / Supavisor). Same database the web app writes to.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sol_lottery?schema=public"

# --- Resolver (optional) ---
# Background worker in src/resolver.ts that drives lotteries through their
# on-chain state machine (request VRF, finalize draws, etc.).
# Set to "1" to skip starting the resolver in this process.
RESOLVER_DISABLED=""
# Path to the keypair used to sign resolver transactions.
# Defaults to ~/.config/solana/id.json when unset.
RESOLVER_KEYPAIR_PATH=""
# Poll interval in milliseconds. Defaults to 15000.
RESOLVER_TICK_MS=""

# --- Shard tracker (optional) ---
# Background worker in src/shard-tracker.ts that mirrors per-shard
# participant counts into Postgres.
SHARD_TRACKER_DISABLED=""
# Poll interval in milliseconds. Defaults to 15000.
SHARD_TRACKER_TICK_MS=""

# --- Seed script (optional) ---
# Read by scripts-seed-from-chain.ts. Falls back to Solana devnet when unset.
NEXT_PUBLIC_SOLANA_RPC=""
